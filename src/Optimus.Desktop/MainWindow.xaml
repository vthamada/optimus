            <DockPanel Margin="0,0,0,10" IsEnabled="{Binding CanEditModules}"><Button DockPanel.Dock="Right" Content="Escolher pasta…" Command="{Binding BrowseFolderSpaceCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding FolderSpacePath, UpdateSourceTrigger=PropertyChanged}" Padding="8" VerticalContentAlignment="Center" AutomationProperties.Name="Pasta explícita para análise de espaço" /></DockPanel>
            <Button Content="Analisar espaço da pasta" Command="{Binding FolderSpaceCommand}" HorizontalAlignment="Left" Margin="0,0,0,18" />
            </StackPanel></Expander><Expander Header="Integridade do Windows (requer administrador)"><StackPanel Margin="10,12,0,0"><TextBlock Text="{Binding IntegrityRequirement}" Style="{StaticResource Requirement}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="Integridade do Windows · verificação sem reparo" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />
            <TextBlock Text="Prepare a prévia e revise os argumentos antes de confirmar. A execução requer contexto já elevado; o aplicativo não solicita elevação automática. O Windows pode gravar logs. Encerramento do comando não equivale a um laudo de integridade." Foreground="#617782" Margin="0,0,0,12" />
            <ComboBox ItemsSource="{Binding IntegrityChoices}" SelectedItem="{Binding SelectedIntegrityChoice}" DisplayMemberPath="Label" IsEnabled="{Binding CanEditModules}" Padding="8" Margin="0,0,0,12" AutomationProperties.Name="Verificação de integridade selecionada" />
            <WrapPanel Margin="0,0,0,12"><Button Content="Preparar prévia" Command="{Binding PlanIntegrityCommand}" Margin="0,0,8,8" /><Button Content="Confirmar e verificar…" Command="{Binding ExecuteIntegrityCommand}" ToolTip="{Binding IntegrityRequirement}" Margin="0,0,0,8" /></WrapPanel>
            <Border Background="#F1F5F7" CornerRadius="7" Padding="14"><TextBlock Text="{Binding IntegrityPreview}" Foreground="#526873" /></Border>
            <TextBlock Text="{Binding IntegrityResult}" Foreground="#526873" Margin="0,12,0,20" />
</StackPanel></Expander><Expander Header="Saúde do disco com SMART (opcional)"><StackPanel Margin="10,12,0,0">
            <TextBlock Text="Saúde de disco com SMART" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Consulte somente um dispositivo selecionado ou importe a saída JSON de uma consulta anterior. SMART não é garantia de vida útil. Não são executados autotestes nem mudanças no dispositivo." Foreground="#617782" Margin="0,0,0,12" />
            <TextBox Text="{Binding SmartTarget, UpdateSourceTrigger=PropertyChanged}" Padding="8" IsEnabled="{Binding CanEditModules}" AutomationProperties.Name="Dispositivo SMART explícito" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,20"><Button Content="Consultar dispositivo" Command="{Binding ReadSmartCommand}" ToolTip="{Binding SmartRequirement}" /><Button Content="Importar JSON…" Command="{Binding ImportSmartCommand}" Margin="8,0,0,0" Background="#E0E8EB" Foreground="#253F47" /></StackPanel>
<TextBlock Text="{Binding SmartRequirement}" Style="{StaticResource Requirement}" AutomationProperties.LiveSetting="Polite" /><Button Content="Configurar smartctl" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:WorkspacePage.Settings}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" /></StackPanel></Expander><TextBlock Text="Resultados das consultas" Style="{StaticResource SectionTitle}" Margin="0,18,0,10" /><TextBlock Text="Execute uma consulta para ver suas fontes abaixo." Style="{StaticResource HelpText}" />            <ItemsControl ItemsSource="{Binding MaintenanceEvidence}" ItemTemplate="{StaticResource EvidenceCard}" />
          </StackPanel></ScrollViewer>
        </TabItem><TabItem Header="Inventário" Tag="{x:Static local:WorkspacePage.Inventory}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,12,12,12">
            <TextBlock Text="Conheça o que está configurado no Windows" FontSize="21" FontWeight="SemiBold" Foreground="#25434C" />
            <TextBlock Text="Consulte rede local, alimentação/bateria, programas registrados e entradas de inicialização. Não são enviados pacotes de teste nem executados programas. Cada evidência informa sua data e cobertura." Foreground="#617782" Margin="0,8,0,14" />
            <Button Content="Consultar inventário local" Command="{Binding InventoryCommand}" HorizontalAlignment="Left" Margin="0,0,0,14" />
            <TextBlock Text="A consulta preserva as outras evidências da sessão com suas datas originais. Entradas de inicialização registradas não comprovam que um programa esteja habilitado ou em execução. O relatório conserva os valores completos selecionados e os limites." Foreground="#617782" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding InventoryEvidence}" ItemTemplate="{StaticResource EvidenceCard}" />
          </StackPanel></ScrollViewer>
        </TabItem><TabItem Header="Backup" Tag="{x:Static local:WorkspacePage.Backup}">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,12,12,12">
            <TextBlock Text="1. Escolha os arquivos e o destino" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding BackupRequirement}" Style="{StaticResource Requirement}" AutomationProperties.LiveSetting="Polite" /><Button Content="Configurar ferramenta de backup" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:WorkspacePage.Settings}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
            <TextBlock Text="Configure o restic em Configuração. O backup usa um repositório local novo; a restauração tem uma prévia separada. Guarde o arquivo de senha em local seguro: perdê-lo pode impedir o acesso ao backup." Foreground="#617782" Margin="0,8,0,16" />
            <StackPanel IsEnabled="{Binding CanEditModules}">
              <TextBlock Text="Pasta de origem" FontWeight="SemiBold" /><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="Escolher…" Command="{Binding BrowseBackupSourceCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding BackupSource, UpdateSourceTrigger=PropertyChanged}" Padding="8" VerticalContentAlignment="Center" /></DockPanel>
              <TextBlock Text="Pasta do backup (repositório novo e vazio)" FontWeight="SemiBold" /><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="Escolher…" Command="{Binding BrowseBackupRepositoryCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding BackupRepository, UpdateSourceTrigger=PropertyChanged}" Padding="8" VerticalContentAlignment="Center" /></DockPanel>
              <TextBlock Text="Arquivo de senha escolhido por você" FontWeight="SemiBold" /><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="Escolher…" Command="{Binding BrowsePasswordCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding PasswordFile, UpdateSourceTrigger=PropertyChanged}" Padding="8" VerticalContentAlignment="Center" /></DockPanel>
            </StackPanel>
            <TextBlock Text="2. Revise antes de executar" Style="{StaticResource SectionTitle}" Margin="0,14,0,10" /><TextBlock Text="{Binding BackupConfirmationHint}" Style="{StaticResource Requirement}" AutomationProperties.LiveSetting="Polite" /><WrapPanel Margin="0,0,0,14"><Button Content="Preparar prévia do backup" Command="{Binding PlanBackupCommand}" /><Button Content="Confirmar e executar…" Command="{Binding ExecuteBackupCommand}" ToolTip="{Binding BackupConfirmationHint}" Margin="8,0,0,0" /></WrapPanel>
            <Border Background="#F1F5F7" CornerRadius="7" Padding="14"><TextBlock Text="{Binding BackupPreview}" Foreground="#526873" /></Border>
            <TextBlock Text="{Binding BackupResult}" Margin="0,12,0,24" Foreground="#526873" />
            <Expander Header="3. Conferir a recuperação dos arquivos"><StackPanel Margin="8,8,0,0">
            <TextBlock Text="A restauração usa o repositório e o arquivo de senha informados acima. Escolha um snapshot e um destino novo." Style="{StaticResource HelpText}" /><TextBlock Text="{Binding RestoreConfirmationHint}" Style="{StaticResource Requirement}" AutomationProperties.LiveSetting="Polite" />
            <StackPanel IsEnabled="{Binding CanEditModules}">
              <TextBlock Text="ID exato do snapshot" FontWeight="SemiBold" /><TextBox Text="{Binding Snapshot, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,5,0,12" />
              <TextBlock Text="Pasta nova para os arquivos restaurados" FontWeight="SemiBold" /><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="Escolher pasta…" Command="{Binding BrowseRestoreDestinationCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding RestoreDestination, UpdateSourceTrigger=PropertyChanged}" Padding="8" VerticalContentAlignment="Center" /></DockPanel>
            </StackPanel>
            <WrapPanel Margin="0,0,0,14"><Button Content="Preparar prévia da restauração" Command="{Binding PlanRestoreCommand}" /><Button Content="Confirmar e restaurar…" Command="{Binding ExecuteRestoreCommand}" ToolTip="{Binding RestoreConfirmationHint}" Margin="8,0,0,0" /></WrapPanel>
            <Border Background="#F1F5F7" CornerRadius="7" Padding="14"><TextBlock Text="{Binding RestorePreview}" Foreground="#526873" /></Border>
            <TextBlock Text="{Binding RestoreResult}" Margin="0,12,0,8" Foreground="#526873" />
          </StackPanel></Expander></StackPanel></ScrollViewer>
        </TabItem><TabItem Header="Assistente IA" Tag="{x:Static local:WorkspacePage.Assistant}">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,12,12,12">
            <TextBlock Text="1. Prepare os dados e o modelo" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding AssistantRequirement}" Style="{StaticResource Requirement}" AutomationProperties.LiveSetting="Polite" /><WrapPanel Margin="0,0,0,18"><Button Content="Configurar IA" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:WorkspacePage.Settings}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" /><Button Content="Coletar dados agora" Command="{Binding StartDiagnosticCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" /></WrapPanel>
            <TextBlock Text="A IA seleciona fatos que podem responder à pergunta. Os valores exibidos vêm das evidências originais; a relevância da seleção pode estar errada. Selecione o motor e o modelo em Configuração." Foreground="#617782" Margin="0,8,0,16" />
            <TextBlock Text="2. O que você quer entender?" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Padding="10" IsEnabled="{Binding CanEditModules}" AutomationProperties.Name="Pergunta para o assistente local" />
            <Button Content="Selecionar fatos com IA local" Command="{Binding AnalyzeCommand}" ToolTip="{Binding AssistantRequirement}" HorizontalAlignment="Left" Margin="0,12,0,18" />
            <Border Background="#EDF7F3" BorderBrush="#CDDFD8" BorderThickness="1" CornerRadius="8" Padding="18"><TextBlock Text="{Binding AssistantSummary}" Foreground="#294F46" FontSize="16" LineHeight="25" /></Border>
            <ItemsControl ItemsSource="{Binding AssistantInsights}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E1E8EC" BorderThickness="0,0,0,1" Padding="0,15"><StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="{Binding Explanation}" Margin="0,6,0,0" Foreground="#617782" />
              <TextBlock Text="{Binding Source.FactKey, StringFormat='Chave original: {0}'}" FontSize="11" Foreground="#75858D" Margin="0,6,0,0" />
              <TextBlock Text="{Binding Source.CapturedAt, StringFormat='Coletado em {0:dd/MM/yyyy HH:mm zzz}'}" FontSize="11" Foreground="#75858D" />
            </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding AssistantDetails}" Foreground="#617782" FontSize="12" Margin="0,16,0,0" />
          </StackPanel></ScrollViewer>
        </TabItem><TabItem Header="Histórico" Tag="{x:Static local:WorkspacePage.History}">
          <Grid Margin="4,12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Até 20 sessões recentes. Ao abrir uma coleta antiga, confira a data: os dados não representam o estado atual." Foreground="#617782" Margin="0,0,0,14" />
            <TextBlock Grid.Row="1" Text="Seu histórico está vazio. Execute um diagnóstico para salvar a primeira sessão." VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HelpText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ListBox Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" DisplayMemberPath="DisplayText" BorderBrush="#DFE7EB" Padding="8" Background="Transparent" AutomationProperties.Name="Sessões de diagnóstico salvas" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Abrir sessão selecionada" ToolTip="Selecione uma sessão da lista para habilitar a abertura." Command="{Binding OpenHistoryCommand}" /><Button Content="Atualizar" Command="{Binding RefreshHistoryCommand}" Margin="8,0,0,0" Background="#E0E8EB" Foreground="#253F47" /></StackPanel>
          </Grid>
        </TabItem><TabItem Header="Configuração" Tag="{x:Static local:WorkspacePage.Settings}">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,12,12,12">
            <TextBlock Text="Recursos opcionais, configurados por você" FontSize="21" FontWeight="SemiBold" Foreground="#25434C" />
            <TextBlock Text="Selecione binários de origem confiável. O aplicativo não instala programas nem baixa modelos nesta tela. Um perfil importado pode fixar SHA-256; mudar o caminho remove essa vinculação." Foreground="#617782" Margin="0,8,0,16" />
            <StackPanel IsEnabled="{Binding CanEditModules}">
              <TextBlock Text="IA local" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding AiConfigurationStatus}" Style="{StaticResource Requirement}" /><TextBlock Text="Motor llama.cpp (llama-completion.exe)" FontWeight="SemiBold" /><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="Escolher…" Command="{Binding BrowseLlamaCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding LlamaPath, UpdateSourceTrigger=PropertyChanged}" Padding="8" VerticalContentAlignment="Center" /></DockPanel>
              <TextBlock Text="Modelo GGUF local" FontWeight="SemiBold" /><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="Escolher…" Command="{Binding BrowseModelCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" Padding="8" VerticalContentAlignment="Center" /></DockPanel>
              <Separator Margin="0,12,0,20" /><TextBlock Text="Backup" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding BackupConfigurationStatus}" Style="{StaticResource Requirement}" /><TextBlock Text="Executável restic" FontWeight="SemiBold" /><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="Escolher…" Command="{Binding BrowseResticCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding ResticPath, UpdateSourceTrigger=PropertyChanged}" Padding="8" VerticalContentAlignment="Center" /></DockPanel>
              <Separator Margin="0,12,0,20" /><TextBlock Text="Saúde do disco (opcional)" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding SmartConfigurationStatus}" Style="{StaticResource Requirement}" /><TextBlock Text="Executável smartctl (opcional)" FontWeight="SemiBold" /><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="Escolher…" Command="{Binding BrowseSmartCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding SmartPath, UpdateSourceTrigger=PropertyChanged}" Padding="8" VerticalContentAlignment="Center" /></DockPanel>
            </StackPanel>
            <Border Style="{StaticResource Notice}"><TextBlock Text="Caminhos informados não significam ferramenta validada: arquivos, permissões e compatibilidade são conferidos ao usar cada recurso. Esta tela não instala componentes." Style="{StaticResource HelpText}" Margin="0" /></Border><TextBlock Text="Reutilizar sua configuração" Style="{StaticResource SectionTitle}" /><TextBlock Text="Exporte um perfil para guardar os caminhos e importe-o ao abrir o programa novamente. O carregamento automático de configuração ainda não está disponível. O perfil não inclui a senha do backup." Style="{StaticResource HelpText}" /><WrapPanel Margin="0,2,0,20"><Button Content="Importar configuração…" Command="{Binding ImportProfileCommand}" /><Button Content="Exportar configuração…" Command="{Binding ExportProfileCommand}" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" /></WrapPanel>
</StackPanel></ScrollViewer></TabItem></TabControl><StackPanel Grid.Row="2" Grid.Column="0" Margin="25,16,16,18"><TextBlock Text="Ferramentas locais · opTImus 0.9.1" Foreground="#566D60" FontSize="11" /><TextBlock Text="Conexões externas são indicadas em cada ação." Foreground="#566D60" FontSize="11" Margin="0,5,0,0" /></StackPanel>
<Grid Grid.Row="2" Grid.Column="1" Margin="30,16,24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<ProgressBar Grid.ColumnSpan="2" Height="3" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,10" Foreground="{StaticResource Accent}" AutomationProperties.Name="Operação em andamento" />
<TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
<WrapPanel Grid.Row="1" Grid.Column="1"><Button Content="Cancelar operação" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" /><Button Content="Exportar relatório…" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Visibility="{Binding HasSession, Converter={StaticResource VisibleWhenTrue}}" /></WrapPanel>
</Grid></Grid></Window>