<StackPanel Grid.Column="0" Grid.Row="0" Margin="26,27,18,22"><TextBlock FontSize="31" FontWeight="Bold" TextWrapping="NoWrap"><Run Text="op" /><Run Text="TI" Foreground="#167257" /><Run Text="mus" /></TextBlock><TextBlock Text="Cuide do seu computador" FontSize="11" Foreground="#566D60" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Row="0" Grid.Column="1" Margin="30,27,24,22"><TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="{Binding PageDescription}" Foreground="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel><TabControl Grid.Row="1" Grid.ColumnSpan="2" x:Name="MainTabs" Foreground="{StaticResource Ink}" Background="{StaticResource Canvas}" TabStripPlacement="Left" SelectedValuePath="Tag" SelectedValue="{Binding SelectedPage, Mode=TwoWay}" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Navegação principal">
  <TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" /></ItemsPanelTemplate></TabControl.ItemsPanel>
<TabControl.Template><ControlTemplate TargetType="TabControl"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="206" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.TabIndex="0" /></ScrollViewer><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" Margin="30,0,24,0" KeyboardNavigation.TabIndex="1" /></Grid></ControlTemplate></TabControl.Template>
<TabItem Header="Visão geral" Tag="{x:Static local:WorkspacePage.Home}"><ScrollViewer><StackPanel Margin="0,0,10,10"><Border Background="#E2EEE7" CornerRadius="12" Padding="28" Margin="0,0,0,22"><StackPanel>
  <TextBlock Text="O primeiro passo" Foreground="#345E4D" FontWeight="SemiBold" FontSize="12" />
  <TextBlock Text="Entenda os sinais do seu computador." FontSize="29" FontWeight="SemiBold" MaxWidth="620" HorizontalAlignment="Left" Margin="0,8,0,12" />
  <TextBlock Text="Reúna informações do sistema, memória, discos e eventos do Windows. Você recebe os dados coletados e recomendações de triagem." MaxWidth="660" HorizontalAlignment="Left" Style="{StaticResource HelpText}" />
  <WrapPanel><Button Content="Iniciar diagnóstico" Command="{Binding StartDiagnosticCommand}" Margin="0,2,12,2" AutomationProperties.Name="Iniciar diagnóstico e abrir os resultados" /><TextBlock Text="Disponível agora · sem configurar IA" VerticalAlignment="Center" FontSize="12" Foreground="#345E4D" Margin="0,8" /></WrapPanel>
</StackPanel></Border>
<TextBlock Text="O que você precisa fazer?" Style="{StaticResource SectionTitle}" /><Border Style="{StaticResource Panel}" Padding="20,4"><StackPanel><Grid Margin="0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="O computador reinicia ou trava" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Consulte reinícios, memória e hardware. A IA é opcional." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" /></StackPanel><Button Grid.Column="1" Content="Investigar →" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:WorkspacePage.Instability}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" /></Grid><Grid Margin="0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Quero consultar algo específico" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Processos, drivers, segurança, discos e outras fontes." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" /></StackPanel><Button Grid.Column="1" Content="Ver consultas →" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:WorkspacePage.Maintenance}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" /></Grid><Grid Margin="0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Quero preservar meus arquivos" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Configure o backup e revise as etapas antes de executar." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" /></StackPanel><Button Grid.Column="1" Content="Preparar backup →" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:WorkspacePage.Backup}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" /></Grid></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Sessão aberta" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding DiagnosticOverview}" FontSize="17" /><TextBlock Text="{Binding SessionDate}" Style="{StaticResource Requirement}" /><TextBlock Text="{Binding DiagnosticNextStep}" Style="{StaticResource HelpText}" /><Button Content="Ver diagnóstico e fontes" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:WorkspacePage.Diagnostics}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" /><Button Content="Abrir histórico →" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:WorkspacePage.History}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" /></StackPanel></Border><Expander Header="O que esta versão permite fazer?"><StackPanel Margin="22,10,0,0"><TextBlock Text="Diagnóstico, inventário e consultas funcionam sem IA. Backup, SMART e análise de dump usam ferramentas opcionais. Limpeza, reparos e instalação de atualizações ou drivers ainda não estão disponíveis." Style="{StaticResource HelpText}" /><Button Content="Conferir configuração das ferramentas" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:WorkspacePage.Settings}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" /></StackPanel></Expander></StackPanel></ScrollViewer></TabItem><TabItem Header="Diagnóstico" Tag="{x:Static local:WorkspacePage.Diagnostics}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4,12,8,10">
              <Border Style="{StaticResource Panel}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Executar novo diagnóstico" VerticalAlignment="Top" Command="{Binding DiagnoseCommand}" Margin="16,0,0,0" /><StackPanel><TextBlock Text="{Binding DiagnosticOverview}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding SessionDate}" Style="{StaticResource Requirement}" /><TextBlock Text="{Binding SessionState}" Foreground="{StaticResource Muted}" /></StackPanel></DockPanel><TextBlock Text="{Binding DiagnosticNextStep}" Style="{StaticResource HelpText}" Margin="0,16,0,0" /></StackPanel></Border><TextBlock Text="{Binding Guidance}" Style="{StaticResource HelpText}" /><TextBlock Text="Achados e recomendações" Style="{StaticResource SectionTitle}" /><TextBlock Text="Execute uma coleta para preencher esta tela. A IA não é necessária para o diagnóstico básico."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HelpText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSession}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate><DataTemplate><Border Background="#FFF7E7" BorderBrush="#F0D9AA" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#62471E" /><TextBlock Text="{Binding Explanation}" Margin="0,6,0,6" Foreground="#685B45" /><TextBlock Text="{Binding Recommendation}" Foreground="#685B45" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Dados por fonte" Style="{StaticResource SectionTitle}" Margin="0,20,0,4" /><TextBlock Text="Abra uma fonte para ver os valores. Datas e limitações pertencem à coleta indicada." Style="{StaticResource HelpText}" /><ItemsControl ItemsSource="{Binding Evidence}" ItemTemplate="{StaticResource EvidenceCard}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem><TabItem Header="Instabilidade" Tag="{x:Static local:WorkspacePage.Instability}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,12,12,12">
            <TextBlock Text="1. Descreva o problema" FontSize="21" FontWeight="SemiBold" Foreground="#25434C" />
            <TextBlock Text="Consulte reinicializações, resultados de memória do Windows e perfil de hardware. A IA local opcional escolhe consultas permitidas; as hipóteses mantêm referências às evidências e não são laudo físico." Foreground="#617782" TextWrapping="Wrap" Margin="0,8,0,14" />
            <StackPanel IsEnabled="{Binding CanEditModules}">
              <TextBlock Text="O que você quer investigar? (até 400 caracteres)" FontWeight="SemiBold" />
              <TextBox Text="{Binding InvestigationQuestion, UpdateSourceTrigger=PropertyChanged}" MaxLength="400" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Padding="9" Margin="0,6,0,10" AutomationProperties.Name="Pergunta de investigação de instabilidade" />
              <WrapPanel Margin="0,0,0,8"><TextBlock Text="Últimos dias" VerticalAlignment="Center" Margin="0,0,8,0" /><ComboBox ItemsSource="{Binding InvestigationDayChoices}" SelectedItem="{Binding InvestigationDays}" Width="90" MaxDropDownHeight="240" Padding="6" AutomationProperties.Name="Janela de um a 365 dias" /></WrapPanel>
<Expander Header="Opções da investigação (IA e dump)"><StackPanel Margin="12,8,0,0"><CheckBox Content="Usar IA local para escolher as consultas" IsChecked="{Binding UseInvestigationAi}" Margin="0,0,0,8" /><CheckBox Content="Incluir o dump selecionado no roteiro" IsChecked="{Binding IncludeDump}" Margin="0,0,0,8" /><TextBlock Text="Sem IA, as três fontes são consultadas uma vez. A IA usa os caminhos de Configuração. Para incluir um dump, informe os caminhos nas opções avançadas abaixo." Style="{StaticResource HelpText}" FontSize="12" /></StackPanel></Expander>
            </StackPanel>
<TextBlock Text="{Binding InvestigationRequirement}" Style="{StaticResource Requirement}" AutomationProperties.LiveSetting="Polite" /><WrapPanel Margin="0,0,0,12"><Button Content="Investigar" Command="{Binding InvestigateCommand}" ToolTip="{Binding InvestigationRequirement}" AutomationProperties.Name="Investigar instabilidade com as opções selecionadas" /><Button Content="Configurar IA opcional" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:WorkspacePage.Settings}" Style="{StaticResource TextButton}" Margin="12,0,0,0" Visibility="{Binding UseInvestigationAi, Converter={StaticResource VisibleWhenTrue}}" /></WrapPanel><Border Background="#F1F5F7" CornerRadius="7" Padding="13" Margin="0,0,0,16"><TextBlock Text="{Binding InvestigationSummary}" TextWrapping="Wrap" Foreground="#526873" /></Border>
            <TextBlock Text="2. Hipóteses e próximos passos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding InvestigationHypotheses}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#FFF7E7" BorderBrush="#F0D9AA" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,0,10"><StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#62471E" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="#685B45" Margin="0,6,0,6" />
              <TextBlock Text="Evidências citadas (IDs originais)" FontSize="11" Foreground="#75858D" />
              <ItemsControl ItemsSource="{Binding EvidenceIds}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="#75858D" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <ItemsControl ItemsSource="{Binding NextChecks}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#685B45" TextWrapping="Wrap" Margin="0,3,0,0" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Expander Header="Rastro das consultas e decisões" Margin="0,6,0,14"><ItemsControl ItemsSource="{Binding InvestigationSteps}" Margin="10,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#DFE7EB" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel>
              <TextBlock Text="{Binding Index, StringFormat='Etapa {0}'}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Tool}" Foreground="#526873" />
              <TextBlock Text="{Binding DecisionSource, StringFormat='Seleção: {0}'}" Foreground="#617782" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DecisionReceipt, StringFormat='Recibo da decisão: {0}'}" Foreground="#617782" TextWrapping="Wrap" FontSize="11" />
              <TextBlock Text="{Binding CompletedAt, StringFormat='Concluída em {0:dd/MM/yyyy HH:mm zzz}'}" Foreground="#75858D" FontSize="11" />
              <ItemsControl ItemsSource="{Binding EvidenceIds}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#75858D" FontSize="11" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
            <TextBlock Text="Fontes observadas e suas limitações" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6" />
            <ItemsControl ItemsSource="{Binding InstabilityEvidence}" ItemTemplate="{StaticResource EvidenceCard}" />
<Expander Header="3. Opções avançadas e relatórios externos"><StackPanel Margin="8,10,0,0">            <Expander Header="Analisar um arquivo de tela azul (.dmp)" IsExpanded="False" Margin="0,0,0,14"><StackPanel Margin="10,12,0,0"><TextBlock Text="{Binding DumpRequirement}" Style="{StaticResource Requirement}" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="Selecione um dump existente, cdb.exe já instalado e uma pasta única de símbolos locais. Nenhum componente será instalado ou baixado. O CDB pode carregar DLLs de sua instalação; escolha uma origem confiável. A análise preserva saída e limites, sem anexar a processos ativos." TextWrapping="Wrap" Foreground="#617782" Margin="0,0,0,12" />
              <StackPanel IsEnabled="{Binding CanEditModules}">
                <TextBlock Text="Depurador CDB local" FontWeight="SemiBold" /><DockPanel Margin="0,5,0,10"><Button DockPanel.Dock="Right" Content="Escolher…" Command="{Binding BrowseCdbCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding CdbPath, UpdateSourceTrigger=PropertyChanged}" Padding="8" AutomationProperties.Name="Executável cdb.exe selecionado" /></DockPanel>
                <TextBlock Text="Pasta local de símbolos" FontWeight="SemiBold" /><DockPanel Margin="0,5,0,10"><Button DockPanel.Dock="Right" Content="Escolher…" Command="{Binding BrowseSymbolDirectoryCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding SymbolDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8" AutomationProperties.Name="Pasta local de símbolos selecionada" /></DockPanel>
                <TextBlock Text="Arquivo de dump" FontWeight="SemiBold" /><DockPanel Margin="0,5,0,10"><Button DockPanel.Dock="Right" Content="Escolher…" Command="{Binding BrowseDumpCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><TextBox Text="{Binding DumpPath, UpdateSourceTrigger=PropertyChanged}" Padding="8" AutomationProperties.Name="Dump selecionado para análise local" /></DockPanel>
              </StackPanel>
              <Button Content="Analisar somente o dump selecionado" Command="{Binding AnalyzeDumpCommand}" ToolTip="{Binding DumpRequirement}" HorizontalAlignment="Left" Margin="0,0,0,8" />
              <TextBlock Text="Um módulo citado pode ser vítima da corrupção. memory_corruption não condena automaticamente a RAM; símbolos incompletos e saídas parciais continuam explícitos." TextWrapping="Wrap" Foreground="#896028" FontSize="12" />
            </StackPanel></Expander>
            <WrapPanel Margin="0,0,0,10"><Button Content="Importar relatório HTML do MemTest86…" Command="{Binding ImportMemoryReportCommand}" Background="#E0E8EB" Foreground="#253F47" /></WrapPanel>
            <TextBlock Text="A importação lê um relatório existente como evidência inerte. Não executa o HTML, não inicia testes físicos e não reinicia o computador. Endereços e bits de erro não identificam sozinhos um módulo físico." TextWrapping="Wrap" Foreground="#617782" FontSize="12" Margin="0,0,0,18" />
</StackPanel></Expander><Expander Header="Consultar suporte e notas de firmware (internet)"><StackPanel Margin="8,10,0,0"><TextBlock Text="{Binding FirmwareRequirement}" Style="{StaticResource Requirement}" AutomationProperties.LiveSetting="Polite" />            <TextBlock Text="Suporte oficial do fabricante" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Confira o modelo e a revisão exatos no fabricante. Estes links não confirmam firmware atualizado, atualização disponível ou imagem compatível. O navegador externo só abre por clique; nenhum dump ou relatório é enviado pelo aplicativo." TextWrapping="Wrap" Foreground="#617782" FontSize="12" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding FirmwareReferences}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4,0,10">
              <TextBlock Text="{Binding Manufacturer}" FontWeight="SemiBold" /><TextBlock Text="{Binding Model}" TextWrapping="Wrap" Foreground="#617782" />
              <TextBlock><Hyperlink NavigateUri="{Binding Url}" RequestNavigate="FirmwareRequestNavigate">Conferir modelo e revisão no suporte oficial</Hyperlink></TextBlock>
              <TextBlock Text="{Binding EvidenceId, StringFormat='Evidência de origem: {0}'}" Foreground="#75858D" FontSize="11" />
            </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border BorderBrush="#DFE7EB" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,8,0,12"><StackPanel>
              <TextBlock Text="Ler notas de firmware em uma página oficial" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock Text="Esta ação faz uma requisição GET pela internet apenas à página HTTPS selecionada, validada para o fabricante observado. Não envia logs, dumps ou relatórios e não baixa nem aplica uma imagem de BIOS. A página pode não conter notas suficientes para confirmar versão, modelo ou revisão. Esta consulta não faz parte do roteiro automático da IA." TextWrapping="Wrap" Foreground="#617782" FontSize="12" Margin="0,0,0,10" />
              <StackPanel IsEnabled="{Binding CanEditModules}">
                <TextBlock Text="Fabricante e equipamento observados" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding FirmwareReferences}" SelectedItem="{Binding SelectedFirmwareReference}" Padding="7" Margin="0,5,0,10" AutomationProperties.Name="Fabricante observado para consulta de notas oficiais"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Manufacturer}" /><TextBlock Text=" · " /><TextBlock Text="{Binding Model}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <TextBlock Text="Cole a URL da página oficial de notas de firmware" FontWeight="SemiBold" />
                <TextBox Text="{Binding FirmwareNotesUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,5,0,10" AutomationProperties.Name="URL explícita de notas de firmware do fabricante" />
              </StackPanel>
              <Button Content="Consultar página oficial (internet)" Command="{Binding ReadFirmwareNotesCommand}" ToolTip="{Binding FirmwareRequirement}" HorizontalAlignment="Left" />
            </StackPanel></Border>
</StackPanel></Expander></StackPanel></ScrollViewer></TabItem><TabItem Header="Consultas" Tag="{x:Static local:WorkspacePage.Maintenance}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,12,12,12">
            <TextBlock Text="Verifique antes de decidir" FontSize="21" FontWeight="SemiBold" Foreground="#25434C" />
            <TextBlock Text="Escolha uma ferramenta para consultar o Windows. Cada fonte informa sua cobertura e data." Foreground="#617782" Margin="0,8,0,14" />
<Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Buscar uma consulta" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBox Text="{Binding MaintenanceSearch, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditModules}" AutomationProperties.Name="Buscar consultas por nome ou assunto" ToolTip="Exemplos: memória, drivers, firewall ou atualizações" />
